# openssl rand -hex 32
SECRET_KEY=ВСТАВЬ_СГЕНЕРИРОВАННЫЙ_КЛЮЧ
DEV_MODE=False
# Публичный адрес сайта (без слеша в конце). Используется для Telegram Login callback.
# Пример: https://mydomain.com
PUBLIC_BASE_URL=http://localhost:8000
# https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=твой_хеш
TELEGRAM_BOT_TOKEN=777777777:AAH...
TELEGRAM_BOT_USERNAME=MyAutoFlowBot
MAILER_DELAY_MIN=30
MAILER_DELAY_MAX=90
MAX_TG_ACCOUNTS=5
ADMIN_TELEGRAM_USERNAME=Cxentrall
ADMIN_TELEGRAM_ID=
# AI-помощник (OpenAI-совместимый API). Оставьте AI_API_KEY пустым —
# тогда работает бесплатный встроенный режим (словарь ответов).
# Groq (бесплатно, быстро): ключ на https://console.groq.com/keys
AI_API_KEY=
AI_API_BASE=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# Альтернативы:
#   Gemini:     AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-1.5-flash
#   OpenRouter: AI_API_BASE=https://openrouter.ai/api/v1                              AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   OpenAI:     AI_API_BASE=https://api.openai.com/v1                                 AI_MODEL=gpt-4o-mini
